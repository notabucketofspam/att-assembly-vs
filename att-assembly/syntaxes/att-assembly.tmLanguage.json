{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AT&T Assembly",
  "scopeName": "source.s",
  "fileTypes": ["s"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#registers" },
    { "include": "#directives" },
    { "include": "#instructions" },
    { "include": "#fpu_instructions" },
    { "include": "#modifiers" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.s"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.s"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.s",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.s" }]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.s",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.s" }]
        }
      ]
    },
    "registers": {
      "match": "%(eax|ebx|ecx|edx|ax|bx|cx|dx|ah|al|bh|bl|ch|cl|dh|dl|edi|esi|esp|ebp|di|si|sp|bp|sph|spl|bph|bpl|cs|ds|es|fs|gs|ss|ip|eip|rip|eflags|rax|rbx|rcx|rdx|rdi|rsi|rsp|rbp|cr|dr|tr|sp|mm|xmm|cr0|cr1|cr2|cr3)\\b",
      "name": "variable.language.register.s"
    },
    "directives": {
      "match": "\\.(code16|code32|arch|ifnb|byte|data|hword|word|int|long|double|short|float|string|string8|string16|ascii|asciz|comm|altmacro|macro|noaltmacro|end|func|endfunc|att_syntax|intel_syntax|att_mnemonic|intel_mnemonic|lcomm|abort|ABORT|align|balignw|balignl|else|elseif|endef|endif|equ|equiv|eqv|err|error|exitm|extern|fail|file|fill|global|globl|gnu_attribute|hidden|ident|if|incbin|include|internal|irp|irpc|lflags|line|linkonce|list|ln|loc|loc_mark_labels|local|mri|nolist|octa|org|p2alignw|p2alignl|popsection|previous|print|protected|psize|purgem|pushsection|quad|reloc|rept|endr|sbttl|scl|section|set|single|size|skip|sleb128|space|stabd|stabn|stabs|struct|subsection|symver|tag|text|title|type|uleb128|val|version|vtable_entry|vtable_inherit|warning|weak|weakref|asciiz|endm)\\b",
      "name": "keyword.control.directive.s"
    },
    "modifiers": {
      "match": "\\b(addr16|addr32)\\b",
      "name": "storage.modifier.s"
    },
    "instructions": {
      "match": "\\b(cli|lss|sti|int|call|ret|iret|nop|hlt|lret|cld|ljmp|aad|aadb|aadw|aadl|aadq|aam|aamb|aamw|aaml|aamq|aas|adc|adcb|adcw|adcl|adcq|add|addb|addw|addl|addq|and|andb|andw|andl|andq|cmp|cmpb|cmpw|cmpl|cmpq|cmpsb|cmpsd|cmpsq|cmpsw|cwd|daa|das|div|mul|idiv|imul|imulb|imulw|imull|imulq|iretq|iretl|in|inb|inl|inw|inq|inc|incb|incw|incl|incq|intb|intw|intl|intq|jmp|jmpb|jmpw|jmpl|jmpq|ja|jae|jb|jbe|jc|jcxz|je|jg|jge|jl|jle|jna|jnae|jnb|jnbe|jnc|jne|jng|jnge|jnl|jnle|jno|jnp|jns|jnz|jo|jp|jpe|jpo|js|jz|lds|ldsb|ldsw|ldsl|ldsq|lea|leab|leaw|leal|leaq|les|lesb|lesw|lesl|lesq|lfs|lfsb|lfsw|lfsl|lfsq|lgs|lgsb|lgsw|lgsl|lgsq|loop|loopb|loopw|loopl|loopq|lodsw|loope|loopeb|loopew|loopel|loopeq|loopne|loopneb|loopnew|loopnel|loopneq|loopnz|loopnzb|loopnzw|loopnzl|loopnzq|loopz|loopzb|loopzw|loopzl|loopzq|mov|movabs|movb|movw|movl|movq|movsd|movsw|movsl|neg|negb|negw|negl|or|orb|orw|orl|orq|outb|outw|outl|pop|popb|popw|popl|popq|popa|popad|popaw|popf|push|pushb|pushw|pushl|pushq|pusha|pushad|pushaw|pushf|rcl|rclb|rclw|rcll|rclq|rcr|rcrb|rcrw|rcrl|rcrq|rol|rolb|rolw|roll|rolq|ror|rorb|rorw|rorl|rorq|sub|subb|subw|subl|subq|shr|shrb|shrw|shrl|shrq|stosb|stosd|stosl|test|testb|testw|testl|testq|xchg|xlatb|xlat|xor|xorb|xorw|xorl|xorq|dec|decb|decw|decl|decq|aaa|cbw|clc|cmc|cmps|esc|into|lahf|lods|lodsb|movs|movsb|not|out|retf|retn|sahf|sal|sar|sbb|scas|scasb|scasw|shl|stc|std|stosw|wait|bound|enter|ins|insb|insw|leave|outs|outsb|outsw|pushw|arpl|lar|lsl|sgdt|sidt|sldt|smsw|str|verr|verw|clts|lgdt|lidt|lldt|lmsw|ltr|bsf|bsr|bt|btc|btr|bts|cdq|cwde|insd|iretd|iretdf|iretf|jecxz|lodsd|loopd|looped|loopned|loopnzd|loopzd|movsx|movzx|outsd|popfd|pushd|pushfd|scasd|seta|setae|setb|setbe|setc|sete|setg|setge|setl|setle|setna|setnae|setnb|setnbe|setnc|setne|setng|setnge|setnl|setnle|setno|setnp|setns|setnz|seto|setp|setpe|setpo|sets|setz|shld|shrd|bswap|cmpxchg|invd|invlpg|wbinvd|xadd|lock|rep|repe|repne|repnz|repz|cflush|cpuid|emms|femms|cmovo|cmovno|cmovb|cmovc|cmovnae|cmovae|cmovnb|cmovnc|cmove|cmovz|cmovne|cmovnz|cmovbe|cmovna|cmova|cmovnbe|cmovs|cmovns|cmovp|cmovpe|cmovnp|cmovpo|cmovl|cmovnge|cmovge|cmovnl|cmovle|cmovng|cmovg|cmovnle|cmpxchg486|cmpxchg8b|loadall|loadall286|ibts|icebp|int1|int3|int01|int03|iretw|popaw|popfw|pushaw|pushfw|rdmsr|rdpmc|rdshr|rdtsc|rsdc|rsldt|rsm|rsts|salc|smi|smint|smintold|svdc|svldt|svts|syscall|sysenter|sysexit|sysret|ud0|ud1|ud2|umov|xbts|wrmsr|wrshr|lcall)\\b",
      "name": "keyword.control.instruction.s"
    },
    "fpu_instructions": {
      "match": "\\b(f2xm1|fabs|fadd|faddp|fbld|fbstp|fchs|fclex|fcom|fcomp|fcompp|fdecstp|fdisi|fdiv|fdivp|fdivr|fdivrp|feni|ffree|fiadd|ficom|ficomp|fidiv|fidivr|fild|fimul|fincstp|finit|fist|fistp|fisub|fisubr|fld|fld1|fldcw|fldenv|fldenvw|fldl2e|fldl2t|fldlg2|fldln2|fldpi|fldz|fmul|fmulp|fnclex|fndisi|fneni|fninit|fnop|fnsave|fnsavew|fnstcw|fnstenv|fnstenvw|fnstsw|fpatan|fprem|fptan|frndint|frstor|frstorw|fsave|fsavew|fscale|fsqrt|fst|fstcw|fstenv|fstenvw|fstp|fstsw|fsub|fsubp|fsubr|fsubrp|ftst|fwait|fxam|fxch|fxtract|fyl2x|fyl2xp1|fsetpm|fcos|fldenvd|fnsaved|fnstenvd|fprem1|frstord|fsaved|fsin|fsincos|fstenvd|fucom|fucomp|fucompp|fcomi|fcomip|ffreep|fcmovb|fcmove|fcmovbe|fcmovu|fcmovnb|fcmovne|fcmovnbe|fcmovnu)\\b",
      "name": "keyword.control.fpu.s"
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\$[0-9a-fA-F]+",
          "name": "constant.numeric.immediate.s"
        },
        {
          "match": "\\b0[xX][0-9a-fA-F]+\\b",
          "name": "constant.numeric.hex.s"
        },
        {
          "match": "\\b0[bB][01]+\\b",
          "name": "constant.numeric.binary.s"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.decimal.s"
        }
      ]
    },
    "operators": {
      "match": "(\\+|-|\\*|/|,|:|\\(|\\)|\\$|=|<<|>|;)",
      "name": "keyword.operator.s"
    }
  }
}
